{
  "systemSetup": [
    {
      "name": "Install pip",
      "command": "curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3 - --break-system-packages"
    }
  ],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install ffmpeg + ffprobe",
      "command": "curl -fsSL https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz | tar -xJf - -C /tmp && ln -sf $(ls -d /tmp/ffmpeg-*-amd64-static | head -1)/ffmpeg /usr/local/bin/ffmpeg && ln -sf $(ls -d /tmp/ffmpeg-*-amd64-static | head -1)/ffprobe /usr/local/bin/ffprobe"
    },
    {
      "name": "Install Python Dependencies",
      "command": "python3 -m pip install --break-system-packages -r requirements.txt"
    }
  ],
  "codeChecks": [
    {
      "name": "Compile Check",
      "command": "python3 -m py_compile tts_engine.py"
    }
  ],
  "buildSteps": [],
  "runStep": [
    {
      "name": "Run TTS Engine",
      "command": "python3 tts_engine.py --port 3000",
      "port": "3000"
    }
  ],
  "deploySteps": [],
  "cleanupFiles": [
    "config_tts.json",
    "models",
    "temp",
    "audio",
    "__pycache__"
  ],
  "packageManager": "pip",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
